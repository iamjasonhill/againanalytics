# Again Analytics / Umami Environment Example

# Primary Postgres connection (use Supabase Postgres connection string)
DATABASE_URL=postgres://username:password@host:5432/umami

# Secret used by Umami to sign tokens
HASH_SALT=replace-with-random-string

# Optional: Enable telemetry or disable if required
UMAMI_TELEMETRY_DISABLED=true

# Optional: Configure next-auth secret if using external auth
# AUTH_SECRET=

# Optional: Disable email verification (true/false)
# DISABLE_EMAIL_VERIFICATION=true
